# Proxmox API Configuration
# Required for Terraform Proxmox Provider
PM_API_URL=https://your-proxmox-host:8006/api2/json
PM_API_TOKEN_ID=your-token-id@pam
PM_API_TOKEN_SECRET=your-uuid-secret-here
PM_TLS_INSECURE=false

# VM Configuration
VM_USER=deploy
VM_PASSWORD=secure-password-here

# SSH Authentication
SSH_PUBLIC_KEY=ssh-ed25519 AAAA... your-username@host

# Deployment Settings
VM_COUNT=1
TARGET_NODE=pve1
STORAGE_POOL=local-zfs
NETWORK_BRIDGE=vmbr0